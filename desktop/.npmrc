; `npm test` requires Node's `--experimental-strip-types` flag (Node >=22.6.0
; only). engine-strict turns package.json's "engines" field into a hard
; `npm install` failure with a clear message on an older Node, instead of a
; confusing runtime "bad option: --experimental-strip-types" error the first
; time someone runs `npm test` — this is exactly what verification against a
; Node 20 machine hit.
engine-strict=true
